# Google Drive 설정 (Streamlit Cloud 배포용)
# 아래 값들을 Streamlit Secrets에 등록하세요

# Google 서비스 계정 JSON (전체 내용)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"koica-pmc-ai-me",...}'

# Google Drive 폴더 ID (6. 문서관리 › Google 드라이브의 '사업 폴더')
GOOGLE_DRIVE_FOLDER_ID=11lix7VWKEQmCW2-iEPxKRfjMe77-uT7D

# Claude API 키 (AI 사업비서용)
ANTHROPIC_API_KEY=sk-ant-...

# 로컬 데이터 폴더 (선택사항)
PMC_DATA_DIR=./pmc

# PDF 한글 폰트 (Windows: 맑은 고딕, Mac: AppleGothic)
PMC_PDF_FONT=Malgun Gothic

# PC에서 내 Google 계정으로 드라이브를 보려면(.env 대신): Google Cloud Console의 OAuth 클라이언트(데스크톱 앱) JSON을
#   config/google_oauth_client.json 으로 저장한 뒤 6. 문서관리 › Google 드라이브 › [Google 계정으로 연결]
